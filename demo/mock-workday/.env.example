# Same value as WORKDAY_WEBHOOK_SECRET in the MyJourney .env. Generate with: openssl rand -hex 32
WORKDAY_WEBHOOK_SECRET=
MYJOURNEY_INTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_MYJOURNEY_PUBLIC_URL=http://localhost:3000

# Separate confidential app registration "team05-mock-workday" with the Microsoft Graph APPLICATION permission
# User.Invite.All (admin consent) and a short-lived client secret. All three are SERVER ONLY: never prefix them
# with NEXT_PUBLIC_, never commit the real values. Delete the secret in Entra after the event.
# Tenant falls back to NEXT_PUBLIC_ENTRA_TENANT_ID when WORKDAY_GRAPH_TENANT_ID is empty.
WORKDAY_GRAPH_TENANT_ID=
WORKDAY_GRAPH_CLIENT_ID=
WORKDAY_GRAPH_CLIENT_SECRET=
# Set to "yes" only after organisers approve Entra emailing external addresses. Otherwise invites are simulated.
# (The old NEXT_PUBLIC_GRAPH_INVITE_EXTERNAL_APPROVED name is still read as a fallback.)
GRAPH_INVITE_EXTERNAL_APPROVED=

# The recruiter console and API only accept requests from this computer (localhost / 127.0.0.1 / ::1).
# Set a PIN if you must reach it from another host (it is then required there). Leave empty otherwise.
RECRUITER_PIN=

# Only used to build the tenant fallback above (no sign-in any more).
NEXT_PUBLIC_ENTRA_TENANT_ID=
# Optional: base URL used in candidate links and QR codes, e.g. http://192.168.1.50:3001 so a phone on the same Wi-Fi can open them.
NEXT_PUBLIC_OFFER_BASE_URL=
