# Copy to .env for local dev. Placeholders only; never commit real values.
DATABASE_URL="file:./dev.db"

# demo = persona switcher (local dev / demo fallback). entra = real MSAL sign-in.
# Demo mode ONLY activates when this is exactly "demo". Demo mode lets anyone pick any persona, ADMIN included.
AUTH_MODE=demo
# Production builds (npm run build && npm start) refuse demo mode unless this is 1. Local demos only.
ALLOW_DEMO_MODE=
# Signs the demo-session cookie. Leave empty (or set 32+ random chars, e.g. `openssl rand -hex 32`).
# Empty, short or "change-me" values use a random per-process key: demo sessions reset on restart.
DEMO_SESSION_SECRET=
# Demo sign-in from any device other than this computer (npm run dev:lan, a tunnel) is refused unless
# DEMO_PIN is set, and then the persona switcher asks for it. Required for dev:lan + demo mode.
# With ALLOWED_DEV_ORIGINS and DEMO_PIN both set, the PIN is asked on every device, this laptop included
# (the "is it local?" headers can be faked by other devices on the network). Use 6+ digits.
DEMO_PIN=

# Entra (AUTH_MODE=entra). Authority is the specific tenant so B2B guests work.
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000

# Adapter mode overrides: MOCK (default) or REAL. Example: ADAPTER_FIRSTADVANTAGE_MODE=MOCK
# ADAPTER_IDENTITY_MODE=MOCK

# Server-side only, for the real chatbot / photo check (WS6).
ANTHROPIC_API_KEY=
# Global cap on Claude calls per day (chat + photo check, per server process). Default 300. Over the cap:
# chat shows "contact P&P", photos go to manual review.
AI_DAILY_CALL_CAP=
# Signs photo-check pass tokens. 32+ random chars; empty = random per-process key (fine for local use).
PHOTO_REF_SECRET=

# LAN access (npm run dev:lan): hosts other devices use to reach this laptop.
# Comma-separated, e.g. 192.168.1.50. Entra sign-in needs HTTPS off localhost; see docs/DEV.md.
ALLOWED_DEV_ORIGINS=

# Brand assets: "official" uses public/brand/official/*; anything else uses the placeholders
NEXT_PUBLIC_BRAND_ASSETS=official
