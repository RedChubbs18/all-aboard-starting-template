{
  "name": "all-aboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-vision-assets.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate && node scripts/copy-vision-assets.mjs",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db prisma/dev.db-journal && npm run db:push && npm run db:seed",
    "dev:lan": "next dev -H 0.0.0.0",
    "dev:lan:https": "next dev -H 0.0.0.0 --experimental-https"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@azure/msal-browser": "^5.29.0",
    "@azure/msal-node": "^7.2.1",
    "@mediapipe/tasks-vision": "^1.2.2",
    "@prisma/client": "^6.19.3",
    "jose": "^6.2.16",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
